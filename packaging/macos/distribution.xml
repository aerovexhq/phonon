<?xml version="1.0" encoding="utf-8"?>
<!--
  Phonon macOS Distribution XML Specification
  For building guided multi-step installer wizard packages (.pkg) via Apple productbuild
-->
<installer-gui-script minSpecVersion="2">
    <title>Phonon Simulation Studio</title>
    
    <options customize="allow"
             require-scripts="true"
             rootVolumeOnly="true"
             hostArchitectures="x86_64,arm64" />
    
    <!-- Presentation & Branding -->
    <welcome file="welcome.html" mime-type="text/html" />
    <license file="license.txt" mime-type="text/plain" />
    
    <!-- Target Domains: Per-machine administrator install -->
    <domains enable_anywhere="false"
             enable_currentUserHome="false"
             enable_localSystem="true" />
    
    <choices-outline>
        <line choice="default">
            <line choice="net.aerovex.phonon.app" />
        </line>
    </choices-outline>
    
    <choice id="default" />
    
    <choice id="net.aerovex.phonon.app"
            visible="true"
            title="Phonon Simulation Studio &amp; CLI"
            description="Installs Phonon Studio.app into /Applications, sets up /usr/local/bin/phonon CLI symlink, and configures shell completions."
            start_selected="true">
        <pkg-ref id="net.aerovex.phonon.app" />
    </choice>
    
    <pkg-ref id="net.aerovex.phonon.app"
             version="0.1.0"
             onConclusion="none">phonon-app.pkg</pkg-ref>
</installer-gui-script>
